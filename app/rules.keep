# R8 rules for MyWifiScan

# Keep all project classes and models
-keep class com.totof.mywifiscan.** { *; }

# Keep data class properties and methods (useful for serialization / UI state)
-keepclassmembers class com.totof.mywifiscan.** {
    *;
}

# Keep network listeners and callbacks (NSD, WifiManager)
-keep class android.net.nsd.* { *; }
-keep class android.net.wifi.* { *; }
-keepclassmembers class * implements android.net.nsd.NsdManager$DiscoveryListener { *; }
-keepclassmembers class * implements android.net.nsd.NsdManager$ResolveListener { *; }

# Ignore warnings and missing classes detected by R8 across dependencies and tests
-ignorewarnings
-dontwarn **
-dontwarn javax.lang.model.element.Modifier
-dontwarn com.google.errorprone.annotations.**
